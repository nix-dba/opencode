{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": ["opencode-omniroute-auth@v1.1.4", [
      "@nix-dba/opencode-plugin-simple-memory@v1.1.0",
      {
        "autoLoad": true,
        "autoSave": true,
        "autoHookTimeoutMs": 100,
        "contextLimit": 5,
        "contextMaxChars": 1200,
        "contextMinScore": 1,
        "autoSaveScope": "user"
      }
    ]],
  "mcp": {
    "gitnexus": {
      "type": "local",
      "command": [
        "gitnexus",
        "mcp"
      ]
    }
  },
  "permission": {
    "edit": {
      "/tmp/*": "allow"
    },
    "read": {
      "*": "allow"
    },
    "glob": {
      "*": "allow"
    },
    "grep": {
      "*": "allow"
    },
    "external_directory": {
      "**/.opencode/**": "allow",
      "**/.gitnexus/**": "allow",
      "*": "allow"
    }
  },
  "instructions": [
    "~/.config/opencode/prompts/general.md",
    "~/.config/opencode/prompts/gitnexus.md",
    "~/.config/opencode/prompts/karpathy.md"
  ]
}

