{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": ["${OPENCODE_OMNIROUTE_AUTH}"],
  "permission": {
    "edit": {
      "/tmp/*": "allow"
    },
    "read": {
      "*": "allow"
    },
    "glob": {
      "*": "allow"
    },
    "grep": {
      "*": "allow"
    },
    "external_directory": {
      "**/.opencode/**": "allow",
      "*": "allow"
    }
  },
  "instructions": [
    "~/.config/opencode/prompts/general.md",
    "~/.config/opencode/prompts/karpathy.md"
  ]
}

