{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": ["opencode-omniroute-auth@v1.1.4"],
  "mcp": {
    "gitnexus": {
      "type": "local",
      "command": [
        "gitnexus",
        "mcp"
      ]
    }
  },
  "permission": {
    "external_directory": {
      "**/.opencode/**": "allow",
      "**/.gitnexus/**": "allow"
    }
  },
  "instructions": [
    "~/.config/opencode/prompts/general.md",
    "~/.config/opencode/prompts/gitnexus.md",
    "~/.config/opencode/prompts/karpathy.md"
  ]
}

