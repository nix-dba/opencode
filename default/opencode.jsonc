{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "compaction": {
    "auto": false
  },
  "plugins": [
    {
      "package": "${OMNIROUTE_PLUGIN_V2}",
      "options": {}
    }
  ],
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "allow" }
  ]
}
